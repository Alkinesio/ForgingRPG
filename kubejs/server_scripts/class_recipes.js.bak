// ---------------------------------------
// AUTO SYNC PLAYER STAGES
// ---------------------------------------

PlayerEvents.tick(event => {

  let player = event.player
  let pstPlayer = PassiveSkillTreeJS.player(player)

  // --- class detection ---
  let hasAnyClass = false
  let playerBaseSkill = null

  for (let className in classSkills) {

    let baseSkill = classSkills[className]

    if (pstPlayer.hasSkill(baseSkill)) {
      hasAnyClass = true
      playerBaseSkill = baseSkill
      break
    }
  }

  // ---------------------------------------
  // HANDLE BLACKSMITH RECIPE STAGES
  // ---------------------------------------

  for (let skill in blacksmithBlocks) {

    let stageName = skill.replace(':', '_')

    // player is blacksmith + owns skill
    let unlocked =
      hasAnyClass &&
      playerBaseSkill === classSkills['Blacksmith'] &&
      pstPlayer.hasSkill(skill)

    if (unlocked) {

      if (!player.stages.has(stageName)) {
        player.stages.add(stageName)
      }

    } else {

      if (player.stages.has(stageName)) {
        player.stages.remove(stageName)
      }
    }
  }
})